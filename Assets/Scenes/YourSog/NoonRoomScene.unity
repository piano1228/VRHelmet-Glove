--- !u!114 &694562042
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 694562040}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c288c844dae1646b931795d801a1fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 376609296}
  lines:
  - isUta: 1
    text:
    - "\u672C\u65E5\u306F\u682A\u5F0F\u4F1A\u793EYour Song\u306B\u3054\u9023\u7D61\u3044\u305F\u3060\u304D\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\u79C1\u306E\u540D\u524D\u306F\u96EA\u4EE3\u8A69\u3068\u3044\u3044\u307E\u3059\u3002\u6539\u3081\u3066\u672C\u65E5\u306F\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
  - isUta: 0
    text:
    - "\u3088\u3001\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3057\u307E\u3059\u3002\u96EA\u2026\u3002\u671B\u6708\u96EA\u3067\u3059\u3002"
    - "\u3054\u3081\u3093\u306A\u3055\u3044\u3002\u307E\u3060\u7DCA\u5F35\u3057\u3066\u3044\u3066\u2026\u3002"
  - isUta: 1
    text:
    - "\u305D\u3046\u3067\u3059\u3088\u306D\u3001\u5C11\u3057\u305A\u3064\u6163\u308C\u3066\u3044\u3051\u3070\u5927\u4E08\u592B\u3067\u3059\u3088\u3002"
  - isUta: 0
    text:
    - "\u306F\u3044\u2026\u3002"
    - "\u3042\u3068\u3001\u308F\u3056\u308F\u3056\u9060\u304F\u304B\u3089\u6765\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  - isUta: 1
    text:
    - "\u3044\u3048\u3044\u3048\u3001\u96EA\u56FD\u306B\u6765\u305F\u306E\u306F\u521D\u3081\u3066\u3067\u3057\u3066\u3002\u65C5\u884C\u6C17\u5206\u3067\u6765\u3089\u308C\u307E\u3057\u305F\u3088\u3002"
    - "\u3067\u3082\u4ECA\u65E5\u306F\u3042\u307E\u308A\u964D\u3063\u3066\u3044\u307E\u305B\u3093\u306D\u3002"
  - isUta: 0
    text:
    - "\u305D\u3046\u3067\u3059\u306D\u3002\u3053\u3093\u306A\u306B\u964D\u3063\u3066\u3044\u306A\u3044\u306E\u306F\u6700\u8FD1\u3067\u306F\u73CD\u3057\u3044\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u305D\u3046\u306A\u3093\u3067\u3059\u306D\u3002\u3084\u306F\u308A\u96EA\u304C\u6BCE\u65E5\u964D\u3063\u3066\u3044\u308B\u306E\u306F\u3044\u308D\u3044\u308D\u3068\u5927\u5909\u306A\u306E\u3067\u3057\u3087\u3046\u304B\uFF1F"
  - isUta: 0
    text:
    - "\u305D\u3046\u3067\u3059\u306D\u3002\u5BD2\u3044\u3057\u96EA\u304B\u304D\u3057\u306A\u3044\u3068\u3060\u3057\u3002\u3080\u3057\u308D\u4ECA\u65E5\u307F\u305F\u3044\u306A\u5929\u6C17\u304C\u305A\u3063\u3068\u7D9A\u3051\u3070\u3044\u3044\u306E\u306B\u3068\u601D\u3046\u304F\u3089\u3044\u3067\u3059\u3088\u3002"
  - isUta: 1
    text:
    - "\u305D\u308C\u306F\u5927\u5909\u305D\u3046\u3067\u3059\u306D\u2026\u3002"
    - "\u2026\u3042\u3042\u3059\u307F\u307E\u305B\u3093\u3002\u95A2\u4FC2\u306A\u3044\u8A71\u3092\u3002"
  - isUta: 0
    text:
    - "\u3044\u3048\u2026\u3002\u3080\u3057\u308D\u3061\u3087\u3063\u3068\u7DCA\u5F35\u304C\u307B\u3050\u308C\u3066\u304D\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u305D\u308C\u306A\u3089\u3088\u304B\u3063\u305F\u3067\u3059\u3002"
    - "\u3067\u306F\u305D\u308D\u305D\u308D\u59CB\u3081\u307E\u3057\u3087\u3046\u304B\u3002\u307E\u305A\u306F\u77E5\u3063\u3066\u3044\u308B\u3068\u601D\u3044\u307E\u3059\u304C\u3001\u79C1\u306E\u304A\u4ED5\u4E8B\u306E\u8AAC\u660E\u3092\u3055\u305B\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
  - isUta: 0
    text:
    - "\u306F\u3001\u306F\u3044\u3002\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
  - isUta: 1
    text:
    - "\u682A\u5F0F\u4F1A\u793EYour Song\u306F\u66F2\u3067\u4EBA\u306E\u5FC3\u306E\u7A74\u3092\u57CB\u3081\u308B\u304A\u4ED5\u4E8B\u3092\u3057\u3066\u3044\u307E\u3059\u3002"
    - "\u624B\u7D19\u3067\u4F9D\u983C\u3092\u53D7\u3051\u308B\u3068\u4F9D\u983C\u4E3B\u306B\u3042\u3063\u305F\u66F2\u306E\u30A4\u30F3\u30B9\u30D4\u30EC\u30FC\u30B7\u30E7\u30F3\u3092\u53D7\u3051\u308B\u305F\u3081\u306B\u4F9D\u983C\u4E3B\u306E\u5BB6\u3078\u8DB3\u3092\u904B\u3073\u307E\u3059\u3002"
    - "\u5BB6\u3067\u306F\u4F9D\u983C\u4E3B\u3068\u306E\u304A\u8A71\u3084\u3001\u304A\u90E8\u5C4B\u304B\u3089\u4F9D\u983C\u4E3B\u3078\u306E\u9020\u5F62\u3092\u6DF1\u3081\u3001\u3088\u308A\u8CEA\u306E\u826F\u3044\u697D\u66F2\u63D0\u4F9B\u3092\u304A\u5C4A\u3051\u3057\u307E\u3059\u3002"
    - "\u3053\u3053\u307E\u3067\u3067\u4F55\u304B\u8CEA\u554F\u306F\u3042\u308A\u307E\u3059\u304B\uFF1F"
  - isUta: 0
    text:
    - "\u5927\u4E08\u592B\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u304B\u3057\u3053\u307E\u308A\u307E\u3057\u305F\u3002"
    - "\u305D\u308C\u3067\u3001\u671B\u6708\u3055\u3093\u306F\u624B\u7D19\u3067\u3042\u308B\u4EBA\u3078\u611F\u8B1D\u306E\u6B4C\u3092\u9001\u308A\u305F\u3044\u3068\u66F8\u304B\u308C\u3066\u3044\u307E\u3057\u305F\u306D\u3002"
  - isUta: 0
    text:
    - "\u306F\u3044\u3002"
  - isUta: 1
    text:
    - "\u305D\u306E\u3042\u308B\u4EBA\u3068\u306F\u3069\u306E\u3088\u3046\u306A\u3054\u95A2\u4FC2\u3067\uFF1F"
  - isUta: 0
    text:
    - "\u3042\u3001\u3048\u3068\u3069\u3053\u304B\u3089\u8A71\u305B\u3070\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\u3002"
    - "\u5F7C\u306F\u4E2D\u5B66\u6821\u6642\u4EE3\u306E\u53CB\u3060\u3061\u306A\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u53CB\u9054\u3067\u3059\u304B\u3002"
  - isUta: 0
    text:
    - "\u305F\u3060\u306E\u53CB\u3060\u3061\u3058\u3083\u306A\u304F\u3066\u2026\u3002\u50D5\u306E\u547D\u306E\u6069\u4EBA\u306A\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u547D\u306E\u6069\u4EBA\u2026\u3002\u3082\u3046\u5C11\u3057\u8A73\u3057\u304F\u304A\u8A71\u9858\u3048\u307E\u3059\u304B\u3002"
  - isUta: 0
    text:
    - "\u306F\u3001\u306F\u3044\u3002"
    - "\u305D\u306E\u3001\u50D5\u2026\u5B9F\u306F\u5C0F\u5B66\u751F\u306E\u9803\u304B\u3089\u3044\u3058\u3081\u3092\u53D7\u3051\u3066\u3044\u305F\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u305D\u3093\u306A\u2026\u306A\u305C\u3067\u3059\u304B\uFF1F"
  - isUta: 0
    text:
    - "\u305D\u308C\u306B\u306F\u3042\u308B\u304D\u3063\u304B\u3051\u304C\u3042\u3063\u3066\u2026"
    - "\u50D5\u3001\u751F\u307E\u308C\u305F\u3068\u304D\u304B\u3089\u8272\u899A\u7570\u5E38\u3092\u6301\u3063\u3066\u3044\u308B\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u8272\u899A\u7570\u5E38\uFF1F"
  - isUta: 0
    text:
    - "\u306F\u3044\u2026\u3002\u7C21\u5358\u306B\u8A00\u3046\u3068\u76EE\u306E\u4E2D\u306B\u3042\u308B\u8272\u3092\u8A8D\u8B58\u3059\u308B\u9310\u4F53\u2026\u3068\u3044\u3046\u3082\u306E\u304C\u3046\u307E\u304F\u50CD\u3044\u3066\u3044\u306A\u304F\u3066\u3002"
  - isUta: 1
    text:
    - "\u5C11\u3057\u96E3\u3057\u3044\u3067\u3059\u306D\u2026\u3002"
  - isUta: 0
    text:
    - "\u3046\u30FC\u3093\u3001\u666E\u901A\u306E\u4EBA\u3068\u306F\u898B\u3066\u3044\u308B\u666F\u8272\u304C\u9055\u3046\u3068\u3044\u3048\u3070\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\u3002"
  - isUta: 1
    text:
    - "\u306A\u308B\u307B\u3069\u2026\u3002\u306A\u305C\u305D\u308C\u304C\u3044\u3058\u3081\u3089\u308C\u308B\u539F\u56E0\u306B\uFF1F"
  - isUta: 0
    text:
    - "\u3042\u306E\u3001\u8272\u899A\u691C\u67FB\u3063\u3066\u308F\u304B\u308A\u307E\u3059\u304B\u3002\u8272\u306E\u4E38\u6A21\u69D8\u306E\u4E2D\u306B\u96A0\u3055\u308C\u305F\u6570\u5B57\u3084\u5F62\u3092\u8AAD\u307F\u53D6\u308B\u3082\u306E\u306A\u3093\u3067\u3059\u3051\u3069\u3002"
  - isUta: 1
    text:
    - "\u306F\u3044\u3002\u5C0F\u5B66\u751F\u306E\u3068\u304D\u306B\u3057\u305F\u306E\u3092\u306A\u3093\u3068\u306A\u304F\u899A\u3048\u3066\u3044\u307E\u3059\u3002"
  - isUta: 0
    text:
    - "\u5C0F\u5B66\u4E00\u5E74\u751F\u306E\u79C1\u306F\u305D\u308C\u3092\u8AAD\u307F\u53D6\u308C\u306A\u304F\u3066\u3002"
    - "\u307F\u3093\u306A\u306E\u524D\u3067\u691C\u67FB\u3092\u3059\u308B\u3082\u306E\u3067\u3057\u305F\u304B\u3089\u3001\u305D\u3093\u306A\u79C1\u3092\u898B\u3066\u30AF\u30E9\u30B9\u306E\u307F\u3093\u306A\u306F\u4E0D\u601D\u8B70\u304C\u3063\u305F\u308A\u9762\u767D\u304C\u3063\u305F\u308A\u3057\u3066\u3044\u307E\u3057\u305F\u3002"
    - "\u300C\u306A\u3093\u3067\u308F\u304B\u3089\u306A\u3044\u306E\u300D\u3068\u304B\u3001\u300C\u308F\u3056\u3068\u9593\u9055\u3048\u3066\u308B\u3067\u3057\u3087\u300D\u3068\u304B\u3002"
    - "\u50D5\u3082\u305D\u3053\u3067\u306F\u3058\u3081\u3066\u6C17\u3065\u3044\u305F\u3093\u3067\u3059\u3002\u81EA\u5206\u306E\u898B\u3066\u3044\u308B\u666F\u8272\u304C\u307B\u304B\u306E\u4EBA\u3068\u306F\u9055\u3046\u3053\u3068\u306B\u3002"
  - isUta: 1
    text:
    - "\u751F\u307E\u308C\u3066\u304B\u3089\u305A\u3063\u3068\u898B\u3066\u304D\u305F\u666F\u8272\u306B\u7591\u554F\u3092\u6301\u3064\u306A\u3093\u3066\u3053\u3068\u306F\u3042\u308A\u307E\u305B\u3093\u3057\u306D\u3002"
  - isUta: 0
    text:
    - "\u305D\u3046\u3067\u3059\u306D\u3002"
  - isUta: 0
    text:
    - "\u3067\u3082\u3001\u8272\u899A\u691C\u67FB\u3068\u3044\u3046\u4E9B\u7D30\u306A\u304D\u3063\u304B\u3051\u3067\u50D5\u306E\u5B66\u6821\u751F\u6D3B\u306F\u60AA\u3044\u65B9\u306B\u5909\u308F\u3063\u3066\u3044\u304D\u307E\u3057\u305F\u3002"
    - "\u30AF\u30E9\u30B9\u306E\u307F\u3093\u306A\u304C\u4F55\u304B\u3068\u8272\u899A\u691C\u67FB\u306E\u3053\u3068\u3092\u3044\u3058\u3063\u3066\u304F\u308B\u3088\u3046\u306B\u306A\u308A\u307E\u3057\u305F\u3002"
    - "\u6700\u521D\u306E\u9803\u306F\u305D\u308C\u3067\u3082\u7B11\u3063\u3066\u307E\u3057\u305F\u3002"
    - "\u50D5\u3082\u8272\u304C\u3046\u307E\u304F\u898B\u3048\u3066\u3044\u306A\u3044\u3068\u3044\u3046\u3053\u3068\u306F\u5909\u3060\u3068\u601D\u3063\u3066\u305F\u3057\u3001\u3061\u3087\u3063\u3068\u3044\u3058\u3089\u308C\u308B\u304F\u3089\u3044\u306F\u306A\u3093\u3066\u3053\u3068\u306A\u304B\u3063\u305F\u3093\u3067\u3059\u3002"
    - "\u3067\u3082\u305D\u308C\u304C\u3060\u3093\u3060\u3093\u3068\u30A8\u30B9\u30AB\u30EC\u30FC\u30C8\u3057\u3066\u3044\u3063\u3066\u2026\u3002\u3060\u3093\u3060\u3093\u3068\u7B11\u3048\u306A\u304F\u306A\u3063\u3066\u3002"
    - "\u3060\u3093\u3060\u3093\u4EBA\u304C\u6016\u304F\u306A\u3063\u3066\u3002"
    - "\u3044\u3058\u3081\u3089\u308C\u3066\u308B\u3063\u3066\u6C17\u3065\u3044\u305F\u3068\u304D\u306B\u306F\u3082\u3046\u82E6\u3057\u304F\u3066\u3001\u5B66\u6821\u306B\u884C\u304F\u306E\u304C\u5ACC\u306B\u306A\u3063\u3066\u3044\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u305D\u308C\u306F\u3064\u3089\u3044\u72B6\u6CC1\u3067\u3057\u305F\u306D\u2026\u3002"
    - "\u8EE2\u6821\u3057\u305F\u308A\u306F\u8003\u3048\u306A\u304B\u3063\u305F\u3093\u3067\u3059\u304B\uFF1F"
  - isUta: 0
    text:
    - "\u3082\u3001\u3082\u3061\u308D\u3093\u8003\u3048\u307E\u3057\u305F\u3002\u3067\u3082\u89AA\u306E\u4ED5\u4E8B\u306E\u90FD\u5408\u304C\u5408\u308F\u306A\u304F\u3066\u2026\u3002"
  - isUta: 1
    text:
    - "\u305D\u3093\u306A\u2026\u3002\u305A\u3063\u3068\u4E00\u4EBA\u3067\u82E6\u3057\u307F\u7D9A\u3051\u3066\u3044\u305F\u3068\u3044\u3046\u3053\u3068\u3067\u3059\u304B\uFF1F"
  - isUta: 0
    text:
    - "\u305D\u3046\u3067\u3059\u306D\u2026\u3002"
    - "\u3057\u304B\u3082\u50D5\u304C\u901A\u3063\u3066\u3044\u305F\u3068\u3053\u308D\u306F\u5C0F\u4E2D\u4E00\u8CAB\u6821\u306A\u3093\u3067\u3059\u3002\u3060\u304B\u3089\u4E2D\u5B66\u306B\u4E0A\u304C\u3063\u3066\u3082\u9854\u3076\u308C\u304C\u5909\u308F\u308B\u3053\u3068\u3082\u306A\u304F\u2026\u3002"
  - isUta: 1
    text:
    - "\u305D\u3093\u306A\u4EBA\u751F\u8010\u3048\u3089\u308C\u307E\u305B\u3093\u306D\u2026\u3002"
  - isUta: 0
    text:
    - "\u5B9F\u969B\u79C1\u3082\u8010\u3048\u3089\u308C\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u3060\u3093\u3060\u3093\u751F\u304D\u308B\u610F\u5473\u304C\u5206\u304B\u3089\u306A\u304F\u306A\u3063\u3066\u3044\u3063\u305F\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u2026\u3002"
  - isUta: 0
    text:
    - "\u3067\u3082\u305D\u3093\u306A\u3068\u304D\u30011\u4EBA\u306E\u7537\u306E\u5B50\u304C\u6771\u4EAC\u304B\u3089\u8EE2\u6821\u3057\u3066\u304D\u305F\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u305D\u308C\u304C\u547D\u306E\u6069\u4EBA\u3067\u3059\u304B\u3002"
  - isUta: 0
    text:
    - "\u305D\u3046\u3067\u3059\u3002\u5F7C\u306F\u572D\u3068\u3044\u3044\u307E\u3059\u3002"
  - isUta: 1
    text:
    - "\u572D\u3055\u3093\u2026\u3002\u5F7C\u304C\u306A\u305C\u671B\u6708\u3055\u3093\u306E\u547D\u306E\u6069\u4EBA\u306B\uFF1F"
  - isUta: 0
    text:
    - "\u572D\u3068\u306F\u4F55\u306E\u304B\u304B\u308F\u308A\u3082\u6301\u3063\u3066\u3044\u307E\u305B\u3093\u3067\u3057\u305F\u3002"
    - "\u305D\u308C\u306B\u50D5\u306F\u30AF\u30E9\u30B9\u3067\u3072\u3068\u308A\u307C\u3063\u3061\u3067\u3057\u305F\u3057\u3001\u4ECA\u5F8C\u3082\u572D\u3068\u306F\u95A2\u308F\u308B\u3053\u3068\u306F\u306A\u3044\u3068\u601D\u3063\u3066\u3044\u307E\u3057\u305F\u3002"
    - "\u3067\u3082\u572D\u304C\u8EE2\u6821\u3057\u305F\u65E5\u306B\u6587\u5316\u796D\u306E\u6E96\u5099\u306E\u4FC2\u6C7A\u3081\u304C\u3042\u3063\u3066\u3002"
    - "\u572D\u3068\u4E00\u7DD2\u306E\u4FC2\u306B\u306A\u3063\u305F\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u306A\u308B\u307B\u3069\u3002"
  - isUta: 0
    text:
    - "\u305D\u3053\u3067\u4F55\u3082\u77E5\u3089\u306A\u3044\u572D\u306F\u50D5\u306B\u8A71\u3057\u304B\u3051\u3066\u304D\u307E\u3057\u305F\u3002\u3053\u306E\u5B66\u6821\u306E\u4E8B\u3084\u79C1\u306E\u3053\u3068\u3068\u304B\u3002"
    - "\u305D\u306E\u9803\u306E\u50D5\u306F\u4EBA\u3068\u8A71\u3059\u306E\u304C\u6016\u304F\u3066\u3001\u982D\u304C\u771F\u3063\u767D\u306B\u306A\u3063\u3066\u3002"
  - isUta: 1
    text:
    - "\u2026\u3002"
  - isUta: 0
    text:
    - "\u4F55\u3082\u8A00\u3048\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u4F55\u304B\u8A00\u304A\u3046\u3068\u3057\u3066\u3082\u58F0\u306F\u51FA\u306A\u304F\u3066\u3002"
    - "\u79C1\u304C\u9707\u3048\u3066\u3044\u305F\u3093\u3060\u3068\u601D\u3044\u307E\u3059\u3002\u572D\u306F\u56F0\u3089\u305B\u308B\u3064\u3082\u308A\u306F\u306A\u304B\u3063\u305F\u3068\u8B1D\u3063\u3066\u304D\u307E\u3057\u305F\u3002"
    - "\u305D\u3057\u3066\u50D5\u304C\u843D\u3061\u7740\u304F\u307E\u3067\u5F85\u3063\u3066\u304F\u308C\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "(\u4EBA\u9593\u6050\u6016\u75C7\u306E\u3088\u3046\u306A\u3082\u306E\u3067\u3057\u3087\u3046\u304B...\u3002)"
  - isUta: 0
    text:
    - "\u305D\u308C\u304B\u3089\u50D5\u306F\u4EBA\u304C\u6016\u3044\u3053\u3068\u3001\u8272\u899A\u7570\u5E38\u304C\u304D\u3063\u304B\u3051\u3067\u3044\u3058\u3081\u3089\u308C\u3066\u304D\u305F\u3053\u3068\u3092\u8A71\u3057\u307E\u3057\u305F\u3002"
    - "\u572D\u306F\u305D\u308C\u3092\u805E\u3044\u3066\u300C\u3064\u3089\u304B\u3063\u305F\u306D\u300D\u3068\u8A00\u3063\u3066\u304F\u308C\u307E\u3057\u305F\u3002"
    - "\u300C\u541B\u306F\u308F\u308B\u304F\u306A\u3044\u300D\u3068\u3001\u300C\u3044\u3058\u3081\u3089\u308C\u308B\u3088\u3046\u306A\u4EBA\u3058\u3083\u306A\u3044\u300D\u3068\u771F\u5263\u306B\u8A00\u3063\u3066\u304F\u308C\u307E\u3057\u305F\u3002"
    - "\u305A\u3063\u3068\u8272\u899A\u7570\u5E38\u3092\u6301\u3063\u3066\u3044\u308B\u81EA\u5206\u304C\u60AA\u3044\u3068\u601D\u3063\u3066\u3044\u305F\u50D5\u306B\u3068\u3063\u3066\u3001\u305D\u308C\u306F\u6551\u3044\u306E\u8A00\u8449\u3067\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u2026\u3002"
  - isUta: 0
    text:
    - "\u305D\u308C\u304B\u3089\u306E\u572D\u3068\u6587\u5316\u796D\u306E\u6E96\u5099\u3092\u3059\u308B\u6642\u9593\u306F\u3068\u3066\u3082\u697D\u3057\u304B\u3063\u305F\u3067\u3059\u3002"
    - "\u4E45\u3057\u3076\u308A\u306B\u5916\u3067\u7B11\u3063\u305F\u6C17\u304C\u3057\u307E\u3057\u305F\u3002"
    - "\u751F\u304D\u308B\u610F\u5473\u304C\u3067\u304D\u305F\u6C17\u304C\u3057\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u2026\u3075\u3075\u3002"
  - isUta: 0
    text:
    - "\u3069\u3001\u3069\u3046\u3057\u307E\u3057\u305F\u304B\u2026?"
  - isUta: 1
    text:
    - "\u3044\u3048\u3002\u5F7C\u306E\u3053\u3068\u3092\u8A71\u3057\u3066\u3044\u308B\u3068\u304D\u306F\u5B89\u5FC3\u3057\u305F\u8868\u60C5\u3092\u6D6E\u304B\u3079\u307E\u3059\u306D\u3002"
  - isUta: 0
    text:
    - "\u3048\u3001\u3042\u3042\uFF01\u305D\u3046\u3067\u3059\u304B\u2026!"
  - isUta: 1
    text:
    - "\u306F\u3044\u3002\u5F7C\u304C\u3069\u308C\u3060\u3051\u5FC3\u306E\u652F\u3048\u306B\u306A\u3063\u3066\u3044\u305F\u304B\u4F1D\u308F\u3063\u3066\u304D\u307E\u3059\u3002"
  - isUta: 0
    text:
    - "\u2026!"
    - "\u3048\u3001\u3048\u3068\u4F55\u3092\u8A71\u3057\u3066\u307E\u3057\u305F\u3063\u3051\u2026?"
  - isUta: 1
    text:
    - "\u5F7C\u3068\u306E\u99B4\u308C\u521D\u3081\u3067\u3059\u304B\u306D\u3002"
  - isUta: 0
    text:
    - "\u305D\u3001\u305D\u3046\u3067\u3057\u305F\u3002"
    - "\u305D\u308C\u304B\u3089\u50D5\u3068\u572D\u306F\u3088\u304F\u4E00\u7DD2\u306B\u3044\u308B\u3088\u3046\u306B\u306A\u308A\u307E\u3057\u305F\u3002"
    - "\u4E00\u7DD2\u306B\u767B\u6821\u3057\u3001\u3054\u306F\u3093\u3092\u98DF\u3079\u3001\u3044\u308D\u3093\u306A\u304A\u8A71\u3092\u3057\u307E\u3057\u305F\u3002"
    - "\u7D75\u3092\u63CF\u304F\u306E\u304C\u597D\u304D\u306A\u3053\u3068\u3001\u30B2\u30FC\u30E0\u306F\u82E6\u624B\u306A\u3053\u3068\u3002"
    - "\u572D\u306F\u305A\u3063\u3068\u305D\u3070\u306B\u3044\u3066\u304F\u308C\u307E\u3057\u305F\u3002"
    - "\u3042\u3093\u306A\u306B\u5B66\u6821\u304C\u5ACC\u3044\u3060\u3063\u305F\u306E\u306B\u572D\u306E\u304A\u304B\u3052\u3067\u5B66\u6821\u306B\u884C\u304D\u305F\u3044\u3068\u601D\u3046\u3088\u3046\u306B\u306A\u308A\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u3044\u307E\u307E\u3067\u8272\u899A\u7570\u5E38\u3092\u6301\u3063\u3066\u3044\u308B\u3068\u3044\u3046\u3060\u3051\u3067\u3044\u3058\u3081\u3089\u308C\u3066\u304D\u305F\u671B\u6708\u3055\u3093\u306B\u3068\u3063\u3066\u5F7C\u306F\u5185\u9762\u3092\u898B\u3066\u304F\u308C\u308B\u552F\u4E00\u306E\u5B58\u5728\u3060\u3063\u305F\u3093\u3067\u3059\u306D\u3002"
  - isUta: 0
    text:
    - "\u305D\u3046\u3067\u3059\u306D\u3002"
    - "\u2026\u2026\u2026\u3002"
  - isUta: 1
    text:
    - "\u3069\u3046\u3057\u307E\u3057\u305F\uFF1F"
  - isUta: 0
    text:
    - "\u3067\u3082\u572D\u3068\u4EF2\u826F\u304F\u306A\u3063\u305F\u3042\u305F\u308A\u304B\u3089\u3042\u308B\u4E0D\u5B89\u304C\u2026\u3002"
  - isUta: 1
    text:
    - "\u4E0D\u5B89\uFF1F"
  - isUta: 0
    text:
    - "\u3051\u3001\u572D\u3068\u4EF2\u826F\u304F\u306A\u308C\u3070\u306A\u308B\u307B\u3069\u2026\u50D5\u3068\u95A2\u308F\u3063\u3066\u3044\u308B\u305B\u3044\u3067\u572D\u307E\u3067\u3044\u3058\u3081\u3089\u308C\u3066\u3057\u307E\u3046\u304B\u3082\u3057\u308C\u306A\u3044\u3068\u3044\u3046\u4E0D\u5B89\u3082\u5897\u3048\u3066\u3044\u304D\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u671B\u6708\u3055\u3093\u3068\u3044\u308B\u3068\u3044\u3046\u3060\u3051\u3067\u2026\u3002"
  - isUta: 0
    text:
    - "\u306F\u3001\u306F\u3044\u3002"
    - "\u305D\u306E\u3001\u50D5\u3068\u572D\u304C\u4EF2\u826F\u304F\u306A\u3063\u3066\u3044\u304F\u306E\u3092\u3088\u304F\u601D\u3063\u3066\u3044\u306A\u3044\u4EBA\u305F\u3061\u304C\u3044\u305F\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u524D\u304B\u3089\u306E\u52A0\u5BB3\u8005\u3067\u3059\u304B\u2026\u3002"
  - isUta: 0
    text:
    - "\u305D\u3001\u305D\u3046\u3067\u3059\u3002"
    - "\u305D\u306E\u4EBA\u305F\u3061\u306F\u79C1\u305F\u3061\u306B\u91CE\u6B21\u3092\u98DB\u3070\u3057\u305F\u308A\u3001\u66B4\u8A00\u3092\u5410\u3044\u305F\u308A\u3057\u3066\u304D\u307E\u3057\u305F\u3002"
    - "\u572D\u306F\u4F55\u3082\u95A2\u4FC2\u306A\u3044\u306E\u306B\u2026\u50D5\u306E\u305B\u3044\u3067\u5927\u5207\u306A\u53CB\u3060\u3061\u304C\u50B7\u3064\u3051\u3089\u308C\u3066\u3057\u307E\u3046\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u671B\u6708\u3055\u3093\u306E\u305B\u3044\u3067\u306F\u306A\u3044\u3068\u601D\u3044\u307E\u3059\u3002"
  - isUta: 0
    text:
    - "\u305D\u308C\u306F\u308F\u304B\u3063\u3066\u3044\u307E\u3059\u2026\u3002\u3067\u3082\u982D\u306E\u4E2D\u306E\u3069\u3053\u304B\u3067\u50D5\u306E\u305B\u3044\u3060\u3068\u601D\u3063\u3066\u3044\u305F\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u2026\u3002"
  - isUta: 0
    text:
    - "\u305D\u308C\u3067\u3082\u572D\u306F\u6BCE\u65E5\u884C\u52D5\u3067\u50D5\u304C\u72EC\u308A\u3058\u3083\u306A\u3044\u3053\u3068\u3092\u4F1D\u3048\u7D9A\u3051\u3066\u304F\u308C\u307E\u3057\u305F\u3002"
    - "\u5468\u308A\u306E\u91CE\u6B21\u3082\u66B4\u8A00\u3082\u5168\u90E8\u805E\u3053\u3048\u3066\u304F\u308C\u308B\u306F\u305A\u306A\u306E\u306B\u3001\u572D\u81EA\u8EAB\u3082\u3064\u3089\u3044\u306F\u305A\u306A\u306E\u306B\u3002"
    - "\u305D\u3093\u306A\u7D20\u632F\u308A\u4E00\u5207\u898B\u305B\u305A\u306B\u305A\u3063\u3068\u4E00\u7DD2\u306B\u3044\u3066\u304F\u308C\u307E\u3057\u305F\u3002"
    - "\u572D\u306E\u614B\u5EA6\u3082\u3042\u3063\u3066\u304B\u3001\u9762\u767D\u304F\u306A\u3044\u3068\u601D\u3063\u305F\u306E\u304B\u3001\u3057\u3070\u3089\u304F\u3059\u308B\u3068\u79C1\u305F\u3061\u306F\u3044\u3058\u3081\u3089\u308C\u305F\u308A\u3059\u308B\u3053\u3068\u306F\u5C11\u306A\u304F\u306A\u3063\u3066\u3044\u304D\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u5F7C\u306F\u672C\u5F53\u306B\u983C\u3082\u3057\u3044\u3067\u3059\u306D\u3002"
  - isUta: 0
    text:
    - "\u306F\u3044\u3002\u572D\u306F\u5F37\u3044\u306A\u3068\u611F\u3058\u307E\u3057\u305F\u3002"
    - "\u30AF\u30E9\u30B9\u306E\u4E2D\u3067\u6D6E\u3044\u3066\u3044\u308B\u306E\u306F\u5909\u308F\u3089\u306A\u3044\u3067\u3059\u304C\u3001\u305D\u308C\u3067\u3082\u79C1\u306F\u572D\u306E\u304A\u304B\u3052\u3067\u3044\u3058\u3081\u3092\u4E57\u308A\u8D8A\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3057\u305F\u3002"
    - "\u3053\u3093\u306A\u672A\u6765\u304C\u304F\u308B\u306A\u3093\u3066\u2026\u3002\u3060\u304B\u3089\u3001\u572D\u306B\u306F\u611F\u8B1D\u3057\u3066\u3082\u3057\u304D\u308C\u306A\u3044\u306E\u3067\u3059\u3002"
    - "\u305D\u3057\u3066\u3001\u96EA\u4EE3\u3055\u3093\u3001\u3042\u306A\u305F\u306E\u5B58\u5728\u3092\u77E5\u308A\u307E\u3057\u305F\u3002"
    - "\u66F2\u3067\u4EBA\u306E\u5FC3\u306E\u7A74\u3092\u57CB\u3081\u308B\u304A\u4ED5\u4E8B\u2026\u3002\u6C17\u304C\u4ED8\u3044\u305F\u3089\u624B\u7D19\u3092\u66F8\u3044\u3066\u3044\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u2026\u79C1\u3092\u983C\u3063\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\u304A\u8A71\u3092\u805E\u3044\u3066\u3044\u304F\u3046\u3061\u306B\u671B\u6708\u3055\u3093\u306E\u5F7C\u3078\u306E\u6C17\u6301\u3061\u304C\u308F\u304B\u3063\u3066\u304D\u307E\u3057\u305F\u3002"
    - "\u5FC5\u305A\u3042\u306A\u305F\u306E\u6C17\u6301\u3061\u304C\u5F7C\u306B\u4F1D\u308F\u308B\u66F2\u3092\u4F5C\u3063\u3066\u307F\u305B\u307E\u3059\u3002"
  - isUta: 0
    text:
    - "\u3053\u3061\u3089\u3053\u305D\u672C\u5F53\u306B\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  - isUta: 1
    text:
    - "\u305D\u308C\u306B\u3057\u3066\u3082\u5F7C\u306F\u306A\u305C\u3053\u3093\u306A\u306B\u3082\u512A\u3057\u3044\u306E\u3067\u3057\u3087\u3046\u306D\u3002"
  - isUta: 0
    text:
    - "\u3042\u3001\u3048\u3068\u572D\u306B\u306A\u305C\u8EE2\u6821\u3057\u3066\u304D\u305F\u306E\u304B\u805E\u3044\u305F\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002"
    - "\u5B9F\u3092\u3044\u3046\u3068\u572D\u3082\u3044\u3058\u3081\u3089\u308C\u3066\u305F\u3093\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u672C\u5F53\u3067\u3059\u304B\u3002"
  - isUta: 0
    text:
    - "\u50D5\u3082\u9A5A\u304D\u307E\u3057\u305F\u3002\u3064\u3089\u304B\u3063\u305F\u304B\u3089\u89AA\u306B\u7121\u7406\u884C\u3063\u3066\u9003\u3052\u51FA\u3057\u305F\u3089\u3057\u3044\u3067\u3059\u3002"
    - "\u572D\u306F\u81EA\u5206\u304C\u3044\u3058\u3081\u3089\u308C\u3066\u3044\u308B\u3068\u304D\u30011\u4EBA\u3067\u3082\u3044\u3044\u304B\u3089\u81EA\u5206\u306E\u5473\u65B9\u304C\u3044\u3066\u304F\u308C\u305F\u3089\u3068\u4F55\u5EA6\u3082\u601D\u3063\u305F\u305D\u3046\u3067\u3059\u3002"
  - isUta: 1
    text:
    - "\u3060\u304B\u3089\u3044\u3058\u3081\u3089\u308C\u3066\u3044\u308B\u671B\u6708\u3055\u3093\u3092\u77E5\u3063\u3066\u307B\u3046\u3063\u3066\u304A\u3051\u306A\u304B\u3063\u305F\u2026\u3002"
  - isUta: 0
    text:
    - "\u81EA\u5206\u306E\u3088\u3046\u306B\u3064\u3089\u3044\u601D\u3044\u306F\u3057\u3066\u307B\u3057\u304F\u306A\u304B\u3063\u305F\u3068\u8A00\u3063\u3066\u3044\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u305D\u3046\u3060\u3063\u305F\u3093\u3067\u3059\u306D\u2026\u3002"
    - "\u672C\u5F53\u306B\u7D20\u6575\u306A\u65B9\u3067\u3059\u306D\u3002"
  - isUta: 0
    text:
    - "\u3059\u3054\u3044\u3067\u3059\u3088\u306D\u2026\u3002\u5F7C\u306F\u3044\u3058\u3081\u3089\u308C\u305F\u7D4C\u9A13\u3067\u79C1\u3092\u3044\u3058\u3081\u304B\u3089\u6551\u3063\u3066\u304F\u308C\u305F\u3093\u3067\u3059\u3002"
