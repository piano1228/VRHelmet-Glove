--- !u!114 &464865696
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 464865695}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c288c844dae1646b931795d801a1fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1435692861}
  lines:
  - isUta: 0
    text:
    - "\u4ECA\u65E5\u306F\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u3044\u3048\u3044\u3048\u3001\u3053\u3061\u3089\u3053\u305D\u3002\u660E\u65E5\u306B\u306F\u5B8C\u6210\u3057\u305F\u66F2\u3092\u304A\u6E21\u3057\u3067\u304D\u308B\u304B\u3068\u601D\u3044\u307E\u3059\u3002"
  - isUta: 0
    text:
    - "\u308F\u304B\u308A\u307E\u3057\u305F\u3002\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
    - "\u2026\u3042\u306E\u3001\u4E00\u3064\u3044\u3044\u3067\u3059\u304B\uFF1F"
  - isUta: 1
    text:
    - "\u3069\u3046\u305E\u3002"
  - isUta: 0
    text:
    - "\u96EA\u4EE3\u3055\u3093\u306F\u4F55\u6545\u3053\u306E\u4ED5\u4E8B\u3092\u3057\u3066\u3044\u308B\u306E\u3067\u3059\u304B\uFF1F"
  - isUta: 1
    text:
    - "\u306A\u305C\u2026\u3067\u3059\u304B\u3002"
  - isUta: 0
    text:
    - "\u7B54\u3048\u306B\u304F\u3044\u306A\u3089\u5168\u7136\u2026"
  - isUta: 1
    text:
    - "\u3044\u3048\u3001\u305D\u3093\u306A\u3053\u3068\u306F\u3002"
    - "\u79C1\u306F\u3082\u3068\u3082\u3068\u97F3\u697D\u304C\u597D\u304D\u3060\u3063\u305F\u3093\u3067\u3059\u3002"
    - "\u3067\u3082\u305D\u308C\u306F\u81EA\u5206\u304C\u597D\u304D\u306A\u97F3\u3067\u4F5C\u3063\u305F\u97F3\u697D\u3067\u3001\u4EBA\u306E\u305F\u3081\u306B\u4F5C\u308B\u306A\u3093\u3066\u3053\u3068\u306F\u8003\u3048\u3066\u3059\u3089\u3044\u307E\u305B\u3093\u3067\u3057\u305F\u3002\r"
    - "\u305D\u3093\u306A\u3068\u304D\u306B\u5927\u5B66\u3067\u3046\u3064\u75C5\u306E\u4EBA\u3068\u51FA\u4F1A\u3044\u307E\u3057\u305F\u3002"
    - "\u5F7C\u306F\u81EA\u5206\u304C\u4E16\u754C\u306E\u3060\u308C\u304B\u3089\u3082\u5FC5\u8981\u3068\u3055\u308C\u3066\u3044\u306A\u3044\u3068\u611F\u3058\u3066\u3044\u307E\u3057\u305F\u3002"
    - "\u305D\u308C\u3067\u5F53\u6642\u306E\u79C1\u306F\u5F7C\u3092\u3069\u3046\u3059\u308C\u3070\u5E78\u305B\u306B\u3067\u304D\u308B\u304B\u8003\u3048\u305F\u3093\u3067\u3059\u3002"
    - "\u305D\u3053\u3067\u8003\u3048\u4ED8\u3044\u305F\u306E\u304C\u3001\u5F7C\u306B\u81EA\u4FE1\u3092\u6301\u3063\u3066\u3082\u3089\u3046\u3053\u3068\u3002"
    - "\u79C1\u306F\u5F7C\u306E\u305F\u3081\u3060\u3051\u306E\u52C7\u6C17\u306E\u6B4C\u3092\u4F5C\u308D\u3046\u3068\u8003\u3048\u307E\u3057\u305F\u3002"
    - "\u3067\u3082\u3001\u305D\u308C\u306B\u306F\u5F7C\u306E\u3053\u3068\u3092\u3082\u3063\u3068\u77E5\u3089\u306A\u3044\u3068\u3044\u3051\u307E\u305B\u3093\u3002"
    - "\u79C1\u306F\u305D\u308C\u304B\u3089\u5F7C\u3068\u4F55\u5EA6\u3082\u8A71\u3057\u307E\u3057\u305F\u3002"
    - "\u5F7C\u3092\u7406\u89E3\u3057\u3066\u3044\u304D\u307E\u3057\u305F\u3002"
    - "\u305D\u3057\u3066\u5F7C\u306E\u305F\u3081\u3060\u3051\u306B\u4F5C\u3063\u305F\u66F2\u3092\u5F7C\u306B\u805E\u304B\u305B\u307E\u3057\u305F\u3002"
    - "\u5F7C\u306F\u6CE3\u3044\u3066\u3044\u307E\u3057\u305F\u3002"
    - "\u79C1\u306F\u305D\u3053\u3067\u4EBA\u306E\u5FC3\u306E\u7A74\u3092\u57CB\u3081\u308B\u3053\u3068\u304C\u3069\u3093\u306A\u306B\u5927\u4E8B\u306A\u306E\u304B\u3092\u77E5\u308A\u307E\u3057\u305F\u3002"
    - "\u305D\u308C\u304B\u3089\u79C1\u306F\u5927\u5B66\u3092\u5352\u696D\u3057Your
      Song\u3068\u3044\u3046\u5C0F\u3055\u306A\u4F1A\u793E\u3092\u7ACB\u3061\u4E0A\u3052\u305F\u3093\u3067\u3059\u3002"
  - isUta: 0
    text:
    - "\u305D\u3093\u306A\u7406\u7531\u304C\u3042\u3063\u305F\u3093\u3067\u3059\u306D\u2026\u3002"
  - isUta: 1
    text:
    - "\u306F\u3044\u3002\u4EBA\u304C\u751F\u304D\u3066\u3044\u304F\u3046\u3048\u3067\u4EBA\u306E\u5F79\u306B\u7ACB\u3063\u3066\u3044\u308B\u3068\u3044\u3046\u611F\u899A\u306F\u5FC5\u8981\u4E0D\u53EF\u6B20\u306A\u306E\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u306D\u3002"
  - isUta: 0
    text:
    - "\u2026\u3002"
  - isUta: 1
    text:
    - "\u305D\u308C\u3067\u306F\u79C1\u306F\u3053\u308C\u3067\u5931\u793C\u3044\u305F\u3057\u307E\u3059\u3002\u672C\u65E5\u306F\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
  - isUta: 0
    text:
    - "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
