  dialog: {fileID: 1393207375}
  lines:
  - isUta: 1
    text:
    - "\u3044\u3084\u30FC\u3001\u4E45\u3057\u3076\u308A\u306B\u4F1A\u3048\u3066\u697D\u3057\u304B\u3063\u305F\u3088\u3002"
    - "\u9AD8\u6821\u751F\u6D3B\u3082\u9806\u8ABF\u305D\u3046\u3067\u3002"
  - isUta: 0
    text:
    - "\u305D\u308C\u3082\u572D\u306E\u304A\u304B\u3052\u3060\u3088\u3002"
  - isUta: 1
    text:
    - "\u3046\u30FC\u3093\u307E\u3042\u305D\u3046\u304B\u3082\uFF1F"
  - isUta: 0
    text:
    - "\u8B19\u905C\u3057\u306A\u3044\u3093\u3060\u3001"
  - isUta: 1
    text:
    - "\u8B19\u905C\u3059\u308B\u4EBA\u306B\u898B\u3048\u308B\uFF1F"
  - isUta: 0
    text:
    - "\u5168\u304F\u3002"
  - isUta: 1
    text:
    - "\u2026\u2026\u3072\u3069\u304F\u306A\u3044\uFF1F"
  - isUta: 0
    text:
    - "\u3075\u3075\u3063"
    - "\u2026\u2026\u2026\u2026"
    - "\u2026\u572D"
  - isUta: 1
    text:
    - "\u306A\u306B\uFF1F"
  - isUta: 0
    text:
    - "\u305D\u306E\u3001\u6E21\u3057\u305F\u3044\u3082\u306E\u304C\u3042\u3063\u3066\u3002"
    - "\u305D\u306E\u3001\u307B\u3089\u3001\u305A\u3063\u3068\u572D\u304C\u50D5\u3092\u652F\u3048\u3066\u304F\u308C\u3066\u305F\u3067\u3057\u3087\u3002"
    - "\u3060\u304B\u3089\u3001\u305D\u306E\u304A\u793C\u3068\u3044\u3046\u304B\u2026\u6C17\u6301\u3061\u3068\u3044\u3046\u304B\u2026\u3002"
  - isUta: 1
    text:
    - "\u306A\u3093\u3060\u306A\u3093\u3060\u30FC\uFF1F\u305D\u3093\u306A\u306B\u6539\u307E\u3063\u3061\u3083\u3063\u3066\u3002"
  - isUta: 0
    text:
    - "\u3046\u3001\u3046\u308B\u3055\u3044\u3002"
  - isUta: 1
    text:
    - "\u3054\u3081\u3093\u3054\u3081\u3093\u3002"
    - "\u305D\u308C\u3067\u3001\u6E21\u3057\u305F\u3044\u3082\u306E\u3063\u3066\uFF1F"
  - isUta: 0
