--- !u!114 &152508427
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 152508425}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f9f591043cca984087d1243a18e1e03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1369872825}
  isChecked: 0
  lines:
  - isUta: 1
    text:
    - "\u8272\u899A\u306B\u95A2\u3059\u308B\u672C\u304C\u591A\u3044\u3067\u3059\u306D\u3002"
  - isUta: 0
    text:
    - "\u305D\u3046\u3067\u3059\u306D\u3002\u5C11\u3057\u524D\u307E\u3067\u8272\u76F2\u3067\u3042\u308B\u3053\u3068\u304C\u5ACC\u3067\u5ACC\u3067\u305F\u307E\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002"
    - "\u306A\u3093\u3060\u304B\u81EA\u5206\u304C\u4E16\u754C\u304B\u3089\u306E\u3051\u8005\u306B\u3055\u308C\u3066\u3044\u308B\u3088\u3046\u306B\u611F\u3058\u3066\u3044\u305F\u3093\u3067\u3059\u3002"
    - "\u3060\u304B\u3089\u4F55\u3068\u304B\u6CBB\u305B\u308B\u65B9\u6CD5\u304C\u306A\u3044\u304B\u8ABF\u3079\u305F\u308A\u3001\u672C\u3092\u8CB7\u3063\u305F\u308A\u3057\u3066\u3044\u307E\u3057\u305F\u3002"
  - isUta: 1
    text:
    - "\u5C11\u3057\u524D\u307E\u3067\u3068\u3044\u3046\u3053\u3068\u306F\u4ECA\u306F\u5ACC\u3067\u306F\u306A\u3044\u306E\u3067\u3059\u304B\uFF1F"
  - isUta: 0
    text:
    - "\u4E0D\u4FBF\u3060\u3068\u601D\u3046\u3068\u304D\u3082\u3042\u308A\u307E\u3059\u304C\u3001\u524D\u306E\u3088\u3046\u306B\u5ACC\u3060\u3068\u601D\u3046\u3053\u3068\u306F\u5C11\u306A\u304F\u306A\u308A\u307E\u3057\u305F\u306D\u3002"
  - isUta: 1
    text:
    - "\u305D\u308C\u306F\u3084\u306F\u308A\u572D\u306E\u5F71\u97FF\u304C\u5927\u304D\u3044\u306E\u3067\u3057\u3087\u3046\u304B\uFF1F"
  - isUta: 0
    text:
    - "\u305D\u3046\u3060\u3068\u601D\u3044\u307E\u3059\u3002\u572D\u306F\u79C1\u306E\u4E16\u754C\u3082\u5C0A\u91CD\u3057\u3066\u304F\u308C\u3066\u3044\u308B\u306E\u3067\u3002"
  - isUta: 1
    text:
    - "\u672C\u5F53\u306B\u5F7C\u306F\u7D20\u6674\u3089\u3057\u3044\u3067\u3059\u306D\u3002"
