    text:
    - "\u672C\u5F53\u3067\u3059\u304B\u2026\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
    - "\u2026\u5B9F\u306F\u4EBA\u306B\u7D75\u3092\u898B\u305B\u308B\u306E\u306F\u82E6\u624B\u3067..\u305D\u306E\u7D75\u3082\u72EC\u7279\u306A\u8272\u4F7F\u3044\uFF1F\u3058\u3083\u306A\u3044\u3067\u3059\u304B\u3002"
